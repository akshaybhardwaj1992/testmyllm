# Copy to .env and fill in. Never commit .env.
# Generate secrets:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"                                   -> JWT_SECRET, POSTGRES_PASSWORD
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"       -> ENCRYPTION_KEY
POSTGRES_PASSWORD=
JWT_SECRET=
ENCRYPTION_KEY=

# First user, created on startup if the database has no users.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Set true when served over HTTPS.
COOKIE_SECURE=false
# Max concurrent judge/model calls per provider across all workers.
PROVIDER_MAX_CONCURRENCY=4

# Provider API keys are NOT configured here: add them in the UI (Settings -> Providers);
# they are encrypted at rest with ENCRYPTION_KEY and never sent to the browser.

# RAG connectors: comma-separated host allow-list (".example.com" = subdomains); empty = any public host.
RAG_HOST_ALLOWLIST=
# Allow connectors to call private/internal addresses. ONLY for local development (e.g. the demo-rag service).
RAG_ALLOW_PRIVATE=false
